#include <stdio.h>

int main() {
    int gold, x, y;
    int ben, blackbeard, remaining, each;

    scanf("%d", &gold);
    scanf("%d", &x);
    scanf("%d", &y);

    ben = gold * x / 100;
    remaining = gold - ben;

    blackbeard = remaining * y / 100;
    remaining = remaining - blackbeard;

    each = remaining / 4;

    printf("%d\n", ben);
    printf("%d\n", blackbeard);
    printf("%d\n", each);

    return 0;
}
